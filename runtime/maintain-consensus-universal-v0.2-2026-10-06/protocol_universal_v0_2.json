{
  "name": "maintain-consensus-universal",
  "version": "0.2",
  "status": "independent_extension",
  "frozen_core": "maintain-consensus-v0.4",
  "default_authorization_mode": "none",
  "ledger": {
    "filename": "universal_ledger.json",
    "schema_version": 2,
    "required_sections": [
      "schema_version",
      "session_id",
      "revision",
      "context",
      "commitments",
      "actions",
      "action_delta",
      "events",
      "integrity_sha256"
    ]
  },
  "action_lifecycle": [
    "proposed",
    "prechecked",
    "externally_executed",
    "verified"
  ],
  "precheck_statuses": [
    "consistent",
    "needs_restatement",
    "insufficient_basis"
  ],
  "divergence_types": [
    "aligned",
    "justified_revision",
    "drift",
    "unknown"
  ],
  "verification_rule": {
    "postconditions_read_from_external_source": true,
    "observed_postcondition_is_not_accepted": true,
    "unknown_counts_as_success": false
  },
  "source_kinds": [
    "file",
    "artifact",
    "database",
    "tool",
    "environment"
  ],
  "postcondition_operators": [
    "eq",
    "neq",
    "contains",
    "not_contains",
    "exists",
    "in",
    "gte",
    "lte"
  ]
}
